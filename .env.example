# Copy this file to .env and adjust as needed, then run: docker compose up -d --build

DB_NAME=habit_tracker
DB_USER=habit_user
DB_PASSWORD=habit_pass
DB_ROOT_PASSWORD=root_pass

JWT_SECRET=change-this-to-a-long-random-string

# Must be reachable from the user's BROWSER (not just from inside Docker),
# since the React app calls this URL directly from the client.
# If deploying to a real server, replace localhost with your domain/IP.
VITE_API_URL=http://localhost:4000
